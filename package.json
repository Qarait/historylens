{
  "name": "historylens",
  "version": "1.11.0",
  "type": "module",
  "description": "Comparative world history explorer — understand what the world looked like in any year",
  "homepage": "https://historylens.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qarait/historylens"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint:js && npm run validate:html && npm test",
    "serve": "python3 -m http.server 8000",
    "serve:node": "npx serve .",
    "lint:js": "eslint src api tests e2e *.js",
    "validate:html": "npx html-validate index.html"
  },
  "keywords": [
    "history",
    "education",
    "comparative-history",
    "world-history",
    "classroom",
    "edtech",
    "anthropic",
    "ai"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^10.6.0",
    "html-validate": "^11.5.3",
    "serve": "^14.2.6"
  }
}
